# Copy to the profile you need (both are gitignored):
#   cp .env.example .env.local   # just serve / eval
#   cp .env.example .env.prod    # just deploy*
#
# agents-cli/ADK only read `.env`. Just materializes the right file:
#   just serve  → cp .env.local .env
#   just deploy → cp .env.prod  .env

# Vertex AI (production default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional: telemetry when running locally against Vertex
# GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# Límite de llamadas LLM por invocación (protección contra loops en Agent Runtime)
# ADK_MAX_LLM_CALLS=10

# --- .env.local: point at local Supabase + Nest ---
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SECRET_KEY=your-local-service-role-key
# CHATTY_API_URL=http://127.0.0.1:3000
# API_WEBHOOK_SECRET=local-dev-api-webhook-secret

# --- .env.prod: point at cloud Supabase + api.chatty.bo ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key
CHATTY_API_URL=https://api.chatty.bo
API_WEBHOOK_SECRET=your-api-webhook-secret

# Dev: just serve sets ADK_DEV_MODE=true
# - Mirrors reply_with_* as playground chat bubbles
# - Skips handoff/score when conversation row is missing
# - Ensures conversations.id = ADK session.id in *local* Supabase only
#   (requires SUPABASE_URL=http://127.0.0.1:54321 + just db-reset; Nest for booking)
# Optional: pin inbox when org has multiple WhatsApp inboxes
# ADK_DEV_INBOX_ID=
# ADK_DEV_MODE=true

# Alternatively, for Gemini API via Google AI Studio,
# comment out Vertex lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Sentry (errors only). Leave empty in .env.local. Set DSN in .env.prod only.
# Do not set SENTRY_VERIFY in .env.prod.
# SENTRY_DSN=
# SENTRY_VERIFY=
